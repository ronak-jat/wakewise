{
  "version": 2,
  "public": false,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/user/(.*)", "destination": "/frontend/user/$1" },
    { "source": "/admin/(.*)", "destination": "/frontend/admin/$1" },
    { "source": "/coach/(.*)", "destination": "/frontend/coach/$1" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/dashboard", "destination": "/frontend/user/dashboard-user.html" },
    { "source": "/dashboard-user.html", "destination": "/frontend/user/dashboard-user.html" },
    { "source": "/dashboard-admin.html", "destination": "/frontend/admin/dashboard-admin.html" },
    { "source": "/dashboard-coach.html", "destination": "/frontend/coach/dashboard-coach.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
