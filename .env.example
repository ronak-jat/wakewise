# ==============================================================================
# WakeWise AI - Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env for local development.
# On Railway, enter these variables into your Project Service Variables settings.
# Do NOT commit your actual .env file or real secrets to Git.
# ==============================================================================

# PostgreSQL Database Connection URL
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_alarm_db
# In Railway production, use the internal or public Railway PostgreSQL connection URL, e.g.:
# DATABASE_URL=postgresql://postgres:PASSWORD@monorail.proxy.rlwy.net:PORT/railway

# Security & JWT Token Signing
# Generate a strong 32+ character random secret for production:
# Command: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
APP_NAME=WakeWise AI Platform API
DEBUG=False

# Frontend Deployment URL (e.g., your Vercel deployment)
# Used for OAuth redirects and CORS policy matching
FRONTEND_URL=https://<your-vercel-domain>.vercel.app

# CORS Allowed Origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://<your-vercel-domain>.vercel.app,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Google OAuth 2.0 Credentials
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# The callback must point to your Railway backend endpoint:
GOOGLE_REDIRECT_URI=https://<your-railway-domain>.up.railway.app/api/auth/google/callback

# AI Provider Configuration (Google Gemini & Groq LPU)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768
# Provider fallback mode: 'auto' (Gemini -> Groq -> Local), 'groq', 'gemini', or 'local'
AI_PROVIDER=auto

# ==============================================================================
# Optional: Email Delivery Settings (SMTP)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-digit-app-password
SMTP_TLS=True
EMAILS_FROM_EMAIL=notifications@wakewise.ai
EMAILS_FROM_NAME=WakeWise AI

# ==============================================================================
# Optional: SMS Delivery Settings (Twilio)
# ==============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
